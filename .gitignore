# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# OS/editor
.DS_Store

# Local data and generated artifacts
artifacts/
checkpoints/
models/
runs/
wandb/
.julia/

# Keep data documentation trackable, but ignore all local/raw data.
data/*
!data/README.md
!data/**/
data/**/raw/*
data/**/*.csv
data/**/*.xlsx
data/**/*.parquet
data/**/*.npy
data/**/*.npz
!data/**/.gitkeep

# Logs and detached runs
*.log
nohup.out

# Large arrays, model weights, and cached tables
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.parquet
*.csv.gz
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# Keep lightweight repository docs/placeholders
!paper_artifacts/
!paper_artifacts/**
!configs/
!scripts/
!tests/
!docs/
!README.md
!environment.yml
!requirements.txt
